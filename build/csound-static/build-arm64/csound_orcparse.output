Grammar

    0 $accept: orcfile $end

    1 orcfile: root_statement_list

    2 root_statement_list: root_statement_list root_statement
    3                    | ε

    4 root_statement: statement
    5               | instr_definition
    6               | udo_definition
    7               | struct_definition
    8               | declare_definition

    9 struct_definition: STRUCT_TOKEN identifier struct_arg_list

   10 struct_arg_list: struct_arg_list ',' struct_arg
   11                | struct_arg_list ',' NEWLINE struct_arg
   12                | struct_arg

   13 struct_arg: identifier
   14           | typed_identifier
   15           | array_identifier

   16 $@1: ε

   17 instr_definition: INSTR_TOKEN instr_id_list NEWLINE $@1 statement_list ENDIN_TOKEN NEWLINE
   18                 | INSTR_TOKEN NEWLINE error

   19 instr_id_list: instr_id_list ',' instr_id
   20              | instr_id

   21 instr_id: integer
   22         | identifier
   23         | plus_identifier

   24 udo_definition: UDOSTART_DEFINITION identifier ',' UDO_IDENT ',' UDO_IDENT NEWLINE statement_list UDOEND_TOKEN NEWLINE
   25               | UDOSTART_DEFINITION identifier udo_arg_list ':' udo_out_arg_list NEWLINE statement_list UDOEND_TOKEN NEWLINE
   26               | UDOSTART_DEFINITION identifier udo_arg_list ':' NEWLINE udo_out_arg_list NEWLINE statement_list UDOEND_TOKEN NEWLINE
   27               | UDOSTART_DEFINITION identifier udo_arg_list NEWLINE ':' udo_out_arg_list NEWLINE statement_list UDOEND_TOKEN NEWLINE

   28 udo_arg_list: '(' out_arg_list ')'
   29             | '(' out_arg_list_array ')'
   30             | '(' ')'

   31 udo_out_arg_list: '(' out_type_list ')'
   32                 | '(' ')'
   33                 | VOID_TOKEN
   34                 | out_type

   35 out_type_list: out_type_list ',' out_type
   36              | out_type

   37 out_type: identifier
   38         | array_identifier

   39 opcall: identifier NEWLINE
   40       | out_arg_list expr_list NEWLINE
   41       | out_arg_list '(' ')' NEWLINE
   42       | out_arg_list identifier expr_list NEWLINE
   43       | out_arg_list identifier NEWLINE
   44       | out_arg_list_array expr_list NEWLINE
   45       | out_arg_list_array '(' ')' NEWLINE
   46       | out_arg_list_array identifier expr_list NEWLINE
   47       | out_arg_list_array identifier NEWLINE
   48       | function_call NEWLINE
   49       | function_call '+' expr_list NEWLINE
   50       | function_call '-' expr_list NEWLINE
   51       | function_call '*' expr_list NEWLINE
   52       | function_call '/' expr_list NEWLINE
   53       | function_call '^' expr_list NEWLINE
   54       | function_call '%' expr_list NEWLINE
   55       | function_call '|' expr_list NEWLINE
   56       | function_call '&' expr_list NEWLINE
   57       | function_call '#' expr_list NEWLINE

   58 function_call: typed_identifierb expr_list ')'
   59              | typed_identifierb ')'
   60              | identifierb expr_list ')'
   61              | identifierb ')'

   62 statement_list: statement_list statement
   63               | statement
   64               | ε

   65 statement: out_arg_list assignment expr_list NEWLINE
   66          | out_arg_list_array assignment_array expr_list NEWLINE
   67          | opcall
   68          | goto identifier NEWLINE
   69          | if_goto
   70          | if_then
   71          | until
   72          | while
   73          | switch
   74          | for_in
   75          | BREAK_TOKEN
   76          | CONTINUE_TOKEN
   77          | LABEL_TOKEN
   78          | NEWLINE

   79 if_goto: IF_TOKEN expr goto T_IDENT NEWLINE

   80 if_then: if_then_base ENDIF_TOKEN NEWLINE
   81        | if_then_base ELSE_TOKEN statement_list ENDIF_TOKEN NEWLINE
   82        | if_then_base elseif_list ENDIF_TOKEN NEWLINE
   83        | if_then_base elseif_list ELSE_TOKEN statement_list ENDIF_TOKEN NEWLINE

   84 if_then_base: IF_TOKEN expr then NEWLINE statement_list

   85 elseif_list: elseif_list elseif
   86            | elseif

   87 elseif: ELSEIF_TOKEN expr then NEWLINE statement_list

   88 until: UNTIL_TOKEN expr DO_TOKEN statement_list OD_TOKEN

   89 while: WHILE_TOKEN expr DO_TOKEN statement_list OD_TOKEN

   90 case: CASE_TOKEN expr_list NEWLINE statement_list
   91     | DEFAULT_TOKEN NEWLINE statement_list

   92 case_list: case_list case
   93          | case
   94          | NEWLINE case_list

   95 switch: SWITCH_TOKEN expr NEWLINE case_list ENDSW_TOKEN

   96 for_in: FOR_TOKEN identifier in expr DO_TOKEN statement_list OD_TOKEN
   97       | FOR_TOKEN identifier ',' identifier in expr DO_TOKEN statement_list OD_TOKEN
   98       | FOR_TOKEN typed_identifier in expr DO_TOKEN statement_list OD_TOKEN
   99       | FOR_TOKEN typed_identifier ',' identifier in expr DO_TOKEN statement_list OD_TOKEN
  100       | FOR_TOKEN typed_identifier ',' typed_identifier in expr DO_TOKEN statement_list OD_TOKEN
  101       | FOR_TOKEN identifier ',' typed_identifier in expr DO_TOKEN statement_list OD_TOKEN

  102 declare_definition: DECLARE_TOKEN identifier udo_arg_list ':' udo_out_arg_list NEWLINE

  103 expr_list: expr_list ',' expr
  104          | expr_list ',' NEWLINE expr
  105          | expr

  106 expr: function_call
  107     | '(' expr ')'
  108     | '(' expr error
  109     | '(' error
  110     | ternary_expr
  111     | unary_expr
  112     | binary_expr
  113     | identifier
  114     | integer
  115     | number
  116     | string
  117     | array_expr
  118     | gen_array
  119     | static_array
  120     | slice_array
  121     | struct_expr
  122     | true_const
  123     | false_const

  124 gen_array: '[' expr S_ELIPSIS2 expr_list ']'

  125 slice_array: identifier '[' expr ':' expr_list ']'
  126            | identifier '[' ':' expr_list ']'
  127            | identifier '[' expr ':' ']'
  128            | expr '[' expr ':' expr_list ']'
  129            | expr '[' ':' expr_list ']'
  130            | expr '[' expr ':' ']'

  131 static_array: '[' expr_list ']'

  132 array_expr: array_expr '[' expr ']'
  133           | identifier '[' expr ']'
  134           | function_call '[' expr ']'

  135 struct_expr: struct_expr '.' identifier
  136            | struct_expr '.' array_expr
  137            | array_expr '.' identifier
  138            | identifier '.' array_expr
  139            | struct_expr '[' expr ']'
  140            | identifier '.' identifier

  141 ternary_expr: expr '?' expr ':' expr
  142             | expr '?' expr ':' error
  143             | expr '?' expr error
  144             | expr '?' error

  145 unary_expr: '~' expr
  146           | '~' error
  147           | '!' expr
  148           | '!' error
  149           | '-' expr
  150           | '-' error
  151           | '+' expr
  152           | '+' error

  153 binary_expr: expr '+' optnewline expr
  154            | expr '+' error
  155            | expr '-' optnewline expr
  156            | expr '-' error
  157            | expr S_LE optnewline expr
  158            | expr S_LE error
  159            | expr S_GE optnewline expr
  160            | expr S_GE error
  161            | expr S_NEQ optnewline expr
  162            | expr S_NEQ error
  163            | expr '=' optnewline expr
  164            | expr '=' error
  165            | expr S_EQ optnewline expr
  166            | expr S_EQ error
  167            | expr S_GT optnewline expr
  168            | expr S_GT error
  169            | expr S_LT optnewline expr
  170            | expr S_LT error
  171            | expr S_AND optnewline expr
  172            | expr S_AND error
  173            | expr S_OR optnewline expr
  174            | expr S_OR error
  175            | expr '*' optnewline expr
  176            | expr '*' error
  177            | expr '/' optnewline expr
  178            | expr '/' error
  179            | expr '^' optnewline expr
  180            | expr '^' error
  181            | expr '%' optnewline expr
  182            | expr '%' error
  183            | expr '|' optnewline expr
  184            | expr '|' error
  185            | expr '&' optnewline expr
  186            | expr '&' error
  187            | expr '#' optnewline expr
  188            | expr '#' error
  189            | expr S_BITSHIFT_LEFT optnewline expr
  190            | expr S_BITSHIFT_LEFT error
  191            | expr S_BITSHIFT_RIGHT optnewline expr
  192            | expr S_BITSHIFT_RIGHT error

  193 out_arg_list: out_arg_list ',' out_arg
  194             | out_arg

  195 out_arg: identifier
  196        | typed_identifier
  197        | array_identifier
  198        | struct_expr

  199 out_arg_list_array: out_arg_list_array ',' array_expr
  200                   | array_expr

  201 array_identifier: array_identifier '[' ']'
  202                 | identifier '[' ']'
  203                 | typed_identifier '[' ']'

  204 assignment: '='
  205           | S_ADDIN
  206           | S_SUBIN
  207           | S_DIVIN
  208           | S_MULIN

  209 assignment_array: '='
  210                 | S_ADDIN
  211                 | S_SUBIN
  212                 | S_DIVIN
  213                 | S_MULIN

  214 in: IN_TOKEN

  215 then: THEN_TOKEN
  216     | KTHEN_TOKEN
  217     | ITHEN_TOKEN

  218 goto: GOTO_TOKEN
  219     | KGOTO_TOKEN
  220     | IGOTO_TOKEN

  221 optnewline: NEWLINE
  222           | ε

  223 string: STRING_TOKEN

  224 false_const: FALSE_TOKEN
  225            | FALSEK_TOKEN

  226 true_const: TRUE_TOKEN
  227           | TRUEK_TOKEN

  228 number: NUMBER_TOKEN

  229 integer: INTEGER_TOKEN

  230 plus_identifier: '+' T_IDENT

  231 typed_identifier: T_TYPED_IDENT

  232 typed_identifierb: T_TYPED_IDENTB

  233 identifier: T_IDENT

  234 identifierb: T_IDENTB


